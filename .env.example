# ==============================================================================
# EDUCO LMS - Environment Variables
# ==============================================================================

# 1. Supabase Client Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 2. Supabase Service Role Key (Used ONLY by scripts/sms-daemon.js for 24/7 background tasks)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 3. SMS Gateway Default Tokens (Configurable via Owner panel in the UI)
# SMS_GATEWAY_PRIMARY_TOKEN=
# SMS_GATEWAY_BACKUP_TOKEN=
